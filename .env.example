# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real key in this file.
#
# One key per provider: config/models.yaml routes different models to
# different endpoints, and sending one provider's key to another returns 401.
#
# An exported shell variable takes precedence over anything set here.

OPENROUTER_API_KEY=
COMMANDCODE_API_KEY=
